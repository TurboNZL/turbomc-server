<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop">
  <id>@Launcher_AppID@</id>
  <name>TurboMC Server</name>
  <summary>Run, update and manage your Minecraft servers from one window</summary>
  <developer id="org.turbonzl">
    <name>TurboNZL</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <description>
    <p>TurboMC Server keeps all your Minecraft servers in one list, in the familiar MultiMC-style window.</p>
    <p>Features:</p>
    <ul>
      <li>Install Vanilla, Paper, Purpur or Fabric servers and change versions with one click</li>
      <li>Start, stop and watch your server from a live console</li>
      <li>Install mods and plugins from Modrinth</li>
      <li>Edit server.properties and back up your worlds</li>
      <li>Nothing updates unless you ask it to</li>
    </ul>
    <p>TurboMC Server is a fork of Prism Launcher and is not affiliated with it, Mojang or Microsoft.</p>
  </description>
  <releases>
    <release version="@Launcher_VERSION_NAME@" date="@Launcher_BUILD_TIMESTAMP@"></release>
  </releases>
  <url type="homepage">https://github.com/TurboNZL/turbomc-server</url>
  <url type="bugtracker">https://github.com/TurboNZL/turbomc-server/issues</url>
  <url type="vcs-browser">https://github.com/TurboNZL/turbomc-server</url>
  <content_rating type="oars-1.1">
    <content_attribute id="violence-fantasy">moderate</content_attribute>
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <launchable type="desktop-id">@Launcher_AppID@.desktop</launchable>
</component>
